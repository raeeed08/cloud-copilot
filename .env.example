# ---- runtime ----------------------------------------------------------------
ENVIRONMENT=dev                 # dev | test | staging | prod (prod requires API_KEYS)
DEMO_MODE=true                  # scan a synthetic estate; set false to scan real accounts
LOG_LEVEL=INFO
LOG_JSON=false

# ---- providers --------------------------------------------------------------
PROVIDERS=aws,azure
# AWS uses the standard credential chain (env, ~/.aws, SSO, IRSA, instance role)
# AWS_PROFILE=security-audit
AWS_REGIONS=                    # empty = every enabled region
AZURE_SUBSCRIPTION_IDS=         # empty = every subscription the identity can read
# AZURE_TENANT_ID= / AZURE_CLIENT_ID= / AZURE_CLIENT_SECRET=  (or az login / workload identity)

# ---- persistence ------------------------------------------------------------
DATABASE_URL=sqlite:///./data/cloud_copilot.db
# DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# Encrypts stored cloud credentials and AI keys (Fernet). Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset in dev, a key is generated into data/secret.key. Required when ENVIRONMENT=prod.
SECRET_KEY=

# ---- API --------------------------------------------------------------------
API_KEYS=                       # comma-separated; empty disables auth (dev only)
CORS_ORIGINS=

# ---- LLM (any OpenAI-compatible endpoint) -----------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODELS=openrouter/free,openai/gpt-oss-20b:free,google/gemma-3-27b-it:free
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODELS=llama-3.3-70b-versatile
# Ollama: LLM_BASE_URL=http://localhost:11434/v1        LLM_MODELS=llama3.2  LLM_API_KEY=ollama
LLM_LANGUAGE=English
LLM_REDACT=true

# ---- RAG --------------------------------------------------------------------
# EMBEDDINGS_BASE_URL=http://localhost:11434/v1   # enables hybrid BM25 + dense retrieval
# EMBEDDINGS_MODEL=nomic-embed-text

# ---- observability ----------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
